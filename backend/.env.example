# Server Configuration
NODE_ENV=development
PORT=3000

# Database Connection (PostgreSQL)
# For host-side local dev (db in docker on localhost:5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cyberisland

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=6h

# Admin Credentials
ADMIN_LOGIN_NAME=admin
ADMIN_PASSWORD=change_this_password

# Contest Configuration
CONTEST_TIMEZONE=Asia/Kolkata
CONTEST_DURATION_MINUTES=180
CONTEST_GRACE_SECONDS=2
