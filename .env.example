# Copy to .env (same folder as docker-compose.yml) and fill in. .env is git-ignored; never commit it.
#
# Values must not contain spaces, quotes or a dollar sign. DB_PASSWORD ends up inside a URL, so use only letters and
# digits there. Easy way to generate a good one:   openssl rand -hex 24

# ---- Where students connect ------------------------------------------------------------------------------
# The single published port: students open  http://<server address>:WEB_PORT
# Pick any free port (80 needs no port in the URL; use e.g. 8080 if 80 is taken or IT assigned you one).
WEB_PORT=80
# Network address to listen on. 0.0.0.0 = every interface. Use a specific address if the server has several.
WEB_BIND=0.0.0.0
# Loopback-only port for the admin SSH tunnel (127.0.0.1, not reachable from the network). Change if 3000 is taken.
BACKEND_LOCAL_PORT=3000

# ---- Secrets (REQUIRED, generate fresh ones) -------------------------------------------------------------
DB_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---- Admin login (REQUIRED). The admin page is reachable from the network, so make both strong ---------------
# A non-obvious login name plus a long random password or passphrase (16+ characters).
ADMIN_LOGIN_NAME=
ADMIN_PASSWORD=

# ---- Optional (defaults shown) ---------------------------------------------------------------------------
# TZ=Asia/Kolkata
# CONTEST_TIMEZONE=Asia/Kolkata
# CONTEST_DURATION_MINUTES=180
# CONTEST_GRACE_SECONDS=2
# JWT_ACCESS_EXPIRES_IN=30m
# JWT_REFRESH_EXPIRES_IN=6h
