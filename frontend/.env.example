# Copy to .env.local (gitignored) to override defaults.

# Backend base URL. Defaults to http://<host serving the game>:3000/api, which is what you want on the event LAN.
# VITE_API_URL=http://192.168.1.50:3000/api

# DEV ONLY (ignored in production builds): skip login/timer and play offline. Nothing is recorded.
# VITE_SKIP_LOGIN=true
