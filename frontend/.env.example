# Copy to .env.local (gitignored) to override defaults.

# Backend base URL. Default: /api on the same origin as the page (nginx in production, the vite proxy in `npm run dev`).
# Only set this if the backend is on a different origin (it would then need CORS enabled).
# VITE_API_URL=http://192.168.1.50:3000/api

# `npm run dev` only: where the vite proxy forwards /api and /admin (default http://localhost:3000)
# VITE_DEV_API_TARGET=http://192.168.1.50:3000

# DEV ONLY (ignored in production builds): skip login/timer and play offline. Nothing is recorded.
# Any non-empty answer passes and hints are placeholders in this mode.
# VITE_SKIP_LOGIN=true
